# 复制这个文件为 .env 再填写。全部配置项见 config.py / 需求说明.md §7

# ===== 必填 =====

# DeepSeek API 密钥 https://platform.deepseek.com (缺了程序拒绝运行)
DEEPSEEK_API_KEY=your_deepseek_key_here

# 自选股列表,逗号分隔(6 位代码)。
# 支持 "代码=推送阈值" 按股覆盖: 600519=低 表示茅台低重要性也推;未标注的用 PUSH_MIN_IMPORTANCE
WATCHLIST=600519,000001,300750

# ===== 常用可调 =====

# 只处理最近 N 天的公告
LOOKBACK_DAYS=3
# 数据渠道: eastmoney(默认) / cninfo / sse_official(上交所官方);
# 逗号分隔可多源合并,如 eastmoney,cninfo。北交所股票请配 cninfo 且用 920 新码
DATA_SOURCE=eastmoney,cninfo
# 推送阈值(低/中/高):低于该重要性的公告不推送
PUSH_MIN_IMPORTANCE=中
# 关键正文抽取关键词(逗号分隔;留空用内置默认: 中标,合同,回购,减持,增持,业绩,诉讼,处罚,并购,重组,分红)
KEYWORDS=

# ===== DeepSeek(OpenAI 兼容) =====

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 大模型调用超时(秒),生成长 JSON 建议保持 60 左右
LLM_TIMEOUT=60
# 摘要失败重试次数(带退避)
LLM_RETRIES=2
# 熔断:连续 N 条真实摘要失败则中止本轮(疑似服务故障),跳过的下次重试;0=关
LLM_CIRCUIT_BREAKER=5
# 单轮真实 AI 摘要调用上限(控费);0=不限。缓存命中不计数
LLM_MAX_CALLS_PER_RUN=50

# ===== 推送 =====

# PushPlus token https://www.pushplus.plus 拿 token;留空则只打印到控制台
PUSHPLUS_TOKEN=
# 采集全失败/推送失败时是否发告警消息(需配 PUSHPLUS_TOKEN)
ALERT_ON_ERROR=false
# 心跳:距上次运行超过 N 天发提醒(捕获定时任务静默挂掉);0=关
HEARTBEAT_DAYS=0
# 单条推送最多公告条数 / 最大字符数,超出拆多条
PUSH_MAX_PER_MESSAGE=8
PUSH_MAX_CHARS=12000

# ===== 正文抓取与处理 =====

# 是否抓取正文(关=只用标题摘要,省时间但质量降)
FETCH_CONTENT=true
# 送模型的关键正文最大字符数
MAX_CONTENT_CHARS=3000
# 例行公告标题预滤:命中跳过 AI 标为低重要性(省 token);ROUTINE_TITLE_PATTERNS 留空用内置默认
ROUTINE_TITLE_FILTER=true
ROUTINE_TITLE_PATTERNS=
# 富化(正文+AI摘要)并发数;过大易触发 LLM 限速
ENRICH_CONCURRENCY=4
# 摘要缓存版本号:调 KEYWORDS 或改 prompt 后 +1,旧缓存全量失效
SUMMARY_CACHE_VERSION=1

# ===== 存储与网络 =====

# 本地去重库/正文缓存保留天数,0=不清理
RETENTION_DAYS=90
# 正文缓存目录 / 日志文件(默认在 data/ 下,一般不用改)
# CONTENT_CACHE_DIR=data/content_cache
# LOG_FILE=data/stock_radar.log
# 外部 HTTP 超时(秒) / 重试次数
REQUEST_TIMEOUT=15
HTTP_RETRIES=2
# 日志级别
LOG_LEVEL=INFO
