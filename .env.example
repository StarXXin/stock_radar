# 复制这个文件为 .env 再填写

# DeepSeek(用 OpenAI 兼容 SDK 调用) https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# PushPlus 微信推送 https://www.pushplus.plus 拿 token;留空则只打印到控制台
PUSHPLUS_TOKEN=

# 自选股列表,逗号分隔(6 位代码:沪市 6 开头 / 深市 0、3 开头)
WATCHLIST=600519,000001,300750

# 只处理最近 N 天的公告
LOOKBACK_DAYS=3
